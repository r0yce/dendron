{
  "$schema": "https://turbo.build/schema.json",
  "pipeline": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["lib/**", "dist/**", "out/**", "*.tsbuildinfo"],
      "inputs": ["src/**/*.ts", "tsconfig*.json", "package.json"]
    },
    "compile": {
      "dependsOn": ["^build"],
      "outputs": ["lib/**", "out/**", "*.tsbuildinfo"],
      "inputs": ["src/**/*.ts", "tsconfig*.json", "package.json", "!src/**/*.test.ts"]
    },
    "tsc": {
      "dependsOn": ["^tsc"],
      "outputs": ["**/*.tsbuildinfo"],
      "inputs": ["src/**/*.ts", "tsconfig*.json", "!**/*.test.*"]
    },
    "doctor": {
      "dependsOn": ["^build"],
      "outputs": [],
      "inputs": ["packages/dendron-cli/src/commands/DoctorCommand.ts", "packages/common-all/src/perf/**"]
    }
  },
  "globalDependencies": ["tsconfig.json", "lerna.json"],
  "globalEnv": ["NODE_ENV", "DENDRON_PERF"]
}
