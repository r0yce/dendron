{
  "name": "root",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "workspaces": {
    "packages": [
      "packages/common-all",
      "packages/common-di",
      "packages/common-assets",
      "packages/common-server",
      "packages/common-test-utils",
      "packages/dendron-viz",
      "packages/engine-server",
      "packages/api-server",
      "packages/engine-test-utils",
      "packages/pods-core",
      "packages/dendron-cli",
      "packages/nextjs-template",
      "packages/plugin-core",
      "packages/common-frontend",
      "packages/dendron-plugin-views",
      "packages/unified"
    ],
    "nohoist": [
      "**/@types/mocha",
      "**/@types/eslint"
    ]
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.7",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "chalk": "5.6.2",
    "eslint": "10.4.1",
    "eslint-config-airbnb": "19.0.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "execa": "9.6.1",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lerna": "9.0.7",
    "lint-staged": "17.0.7",
    "lodash": "4.18.1",
    "madge": "8.0.0",
    "prettier": "3.8.3",
    "standard-version": "9.5.0",
    "tsup": "8.5.1",
    "typedoc": "0.28.19",
    "typedoc-plugin-markdown": "4.11.0",
    "verdaccio": "6.7.2",
    "verdaccio-auth-memory": "13.0.2",
    "vsce": "2.15.0"
  },
  "scripts": {
    "setup": "yarn && yarn bootstrap:bootstrap && yarn bootstrap:build && yarn setup:cli",
    "setup:cli": "./bootstrap/scripts/chmod-cli.js",
    "build:prerelease:local": "cross-env UPGRADE_TYPE=prerelease PUBLISH_ENDPOINT=local ./bootstrap/scripts/buildPatch.sh",
    "build:prerelease:remote": "cross-env UPGRADE_TYPE=prerelease PUBLISH_ENDPOINT=remote ./bootstrap/scripts/buildPatch.sh",
    "build:prerelease:remote:ci": "cross-env UPGRADE_TYPE=prerelease PUBLISH_ENDPOINT=remote BUILD_ENV=ci ./bootstrap/scripts/buildPatch.sh",
    "build:patch:local": "cross-env UPGRADE_TYPE=patch PUBLISH_ENDPOINT=local USE_IN_MEMORY_REGISTRY=1 ./bootstrap/scripts/buildPatch.sh",
    "build:patch:local:ci": "cross-env UPGRADE_TYPE=patch PUBLISH_ENDPOINT=local BUILD_ENV=ci USE_IN_MEMORY_REGISTRY=1 ./bootstrap/scripts/buildPatch.sh",
    "build:patch:local:ci:nightly": "./bootstrap/scripts/buildNightly.sh",
    "build:patch:remote": "cross-env UPGRADE_TYPE=patch PUBLISH_ENDPOINT=remote ./bootstrap/scripts/buildPatch.sh",
    "build:patch:remote:ci": "cross-env UPGRADE_TYPE=patch PUBLISH_ENDPOINT=remote BUILD_ENV=ci ./bootstrap/scripts/buildPatch.sh",
    "build:minor:local": "cross-env UPGRADE_TYPE=minor PUBLISH_ENDPOINT=local ./bootstrap/scripts/buildPatch.sh",
    "build:minor:local:ci": "cross-env UPGRADE_TYPE=minor PUBLISH_ENDPOINT=local BUILD_ENV=ci USE_IN_MEMORY_REGISTRY=1 ./bootstrap/scripts/buildPatch.sh",
    "build:minor:remote": "cross-env UPGRADE_TYPE=minor PUBLISH_ENDPOINT=remote ./bootstrap/scripts/buildPatch.sh",
    "build:minor:remote:ci": "cross-env UPGRADE_TYPE=minor PUBLISH_ENDPOINT=remote BUILD_ENV=ci ./bootstrap/scripts/buildPatch.sh",
    "gen:data": "yarn dendron dev generate_json_schema_from_config",
    "dendron": "node packages/dendron-cli/lib/bin/dendron-cli.js",
    "cleanup": "./bootstrap/scripts/cleanup.sh",
    "release": "standard-version",
    "format": "lerna exec --parallel -- yarn format",
    "format:pkg": "prettier --write",
    "lint": "eslint . --ext ts,tsx",
    "lerna:typecheck": "lerna exec --parallel --ignore @dendronhq/common-assets --ignore @dendronhq/dendron-plugin-views -- tsc -p tsconfig.build.json --noEmit",
    "bootstrap:bootstrap": "npx yarn --network-timeout 600000 --frozen-lockfile && yarn gen:meta",
    "bootstrap:build": "node bootstrap/scripts/buildAll.js",
    "bootstrap:buildCI": "node bootstrap/scripts/buildAllForTest.js",
    "bootstrap:build:common-di": "yarn workspace @dendronhq/common-di run build",
    "bootstrap:build:unified": "yarn workspace @dendronhq/unified run build",
    "bootstrap:build:fast": "yarn bootstrap:build:common-all && yarn bootstrap:build:common-di && yarn bootstrap:build:unified && yarn bootstrap:build:common-server && yarn bootstrap:build:common-test-utils && yarn bootstrap:build:engine-server && yarn bootstrap:build:pods-core && yarn bootstrap:build:api-server && yarn bootstrap:build:engine-test-utils && yarn bootstrap:build:dendron-cli && yarn bootstrap:build:plugin-core",
    "bootstrap:build:turbo": "npx turbo run build --filter=@dendronhq/common-all --filter=@dendronhq/common-di --filter=@dendronhq/unified --filter=@dendronhq/common-server --filter=@dendronhq/engine-server --filter=@dendronhq/pods-core --filter=@dendronhq/api-server --filter=@dendronhq/dendron-cli --filter=@dendronhq/plugin-core",
    "bootstrap:build:modern-fast": "yarn workspace @dendronhq/common-all run build:modern && yarn workspace @dendronhq/common-server run build:modern && yarn workspace @dendronhq/unified run build:modern && yarn workspace @dendronhq/engine-server run build:modern && yarn workspace @dendronhq/engine-test-utils run build:modern && yarn workspace @dendronhq/pods-core run build:modern && yarn workspace @dendronhq/api-server run build:modern && yarn workspace @dendronhq/dendron-cli run build:modern && yarn workspace @dendronhq/common-frontend run build:modern && yarn workspace @dendronhq/dendron-viz run build:modern",
    "bootstrap:build:nextjs-template": "yarn workspace @dendronhq/nextjs-template run build",
    "bootstrap:build:common-all": "yarn workspace @dendronhq/common-all run build",
    "bootstrap:build:common-frontend": "yarn workspace @dendronhq/common-frontend run build",
    "bootstrap:build:plugin-core": "yarn workspace @dendronhq/plugin-core run build",
    "bootstrap:build:common-server": "yarn workspace @dendronhq/common-server run build",
    "bootstrap:build:common-test-utils": "yarn workspace @dendronhq/common-test-utils run build",
    "bootstrap:build:engine-server": "yarn workspace @dendronhq/engine-server run build",
    "bootstrap:build:api-server": "yarn workspace @dendronhq/api-server run build",
    "bootstrap:build:engine-test-utils": "yarn workspace @dendronhq/engine-test-utils run build",
    "bootstrap:build:pods-core": "yarn workspace @dendronhq/pods-core run build",
    "bootstrap:build:dendron-cli": "yarn workspace @dendronhq/dendron-cli run build",
    "bootstrap:init": "yarn bootstrap:bootstrap && yarn bootstrap:build",
    "ci:init": "yarn bootstrap:bootstrap && yarn bootstrap:buildCI",
    "verify:local": "yarn bootstrap:build:fast && yarn workspace @dendronhq/plugin-core compile",
    "verify:full": "yarn verify:local && yarn bootstrap:buildCI && yarn test:doctor:smoke && yarn test:cli:smoke",
    "verify:modernization": "yarn verify:full && yarn dendron health --help",
    "extension:package": "yarn bootstrap:build:fast && yarn workspace @dendronhq/plugin-core run build:prod && yarn workspace @dendronhq/plugin-core run package:vsix:modern",
    "ci:test:cli": "yarn test:cli",
    "ci:test:plugin": "npx lerna run test --scope @dendronhq/plugin-core --stream",
    "ci:test:plugin-web": "npx lerna run compile-web --scope @dendronhq/plugin-core && npx lerna run test-in-browser --scope @dendronhq/plugin-core",
    "ci:test:plugin-perf": "npx lerna run perf-test --scope @dendronhq/plugin-core",
    "ci:test:template": "yarn --cwd packages/nextjs-template run test",
    "ci:test:template:docker": "docker run -it --rm --ipc=host -v \"$(pwd):/test\" -u \"$(id -u ${USER}):$(id -g ${USER})\" mcr.microsoft.com/playwright:v1.26.0-focal /bin/bash -c 'cd /test; npx playwright install; yarn ci:test:template $([ \"$0\" = \"/bin/bash\" ] || ([ \"$#\" = 0 ] && echo \"$0\" || echo \"$0 $@\"))'",
    "template:build": "yarn --cwd packages/nextjs-template run build",
    "template:export": "yarn --cwd packages/nextjs-template run export",
    "template:start": "yarn --cwd packages/nextjs-template run start",
    "watch": "npx lerna exec --scope $pkg -- tsc -p tsconfig.build.json --watch ",
    "prepare": "husky",
    "hooks:pre-commit": "node ./hooks/pre-commit.js",
    "hooks:pre-push": "node ./hooks/pre-push.js",
    "gen:meta": "node ./bootstrap/scripts/genMeta.js",
    "backend:updateDendronDeps": "node bootstrap/backend/updateDendronhqDeps.js",
    "stash:unstaged": "git stash save -k 'pre-linting-stash'",
    "stash:pop": "git stash && git stash pop stash@{1} && git read-tree stash && git stash drop",
    "test": "cross-env LOG_LEVEL=error yarn jest",
    "test:cli": "cross-env LOG_LEVEL=error npx jest --selectProjects non-plugin-tests --forceExit",
    "test:cli:smoke": "cross-env LOG_LEVEL=error npx jest --selectProjects non-plugin-tests --testPathPattern=launchEngineServer.spec --forceExit",
    "test:doctor:smoke": "node -r ts-node/register/transpile-only packages/dendron-cli/src/commands/DoctorCommand.test.ts",
    "test:cli:update-snapshots": "yarn test:cli -u",
    "ci:test:cli:smoke": "yarn test:cli:smoke && yarn test:doctor:smoke"
  },
  "packages": [
    "packages/*",
    "vendor/*"
  ],
  "useWorkspaces": false,
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --config prettier.config.js --loglevel debug --write",
      "eslint"
    ]
  },
  "dependencies": {
    "@babel/helper-string-parser": "7.29.7",
    "@babel/preset-typescript": "7.29.7",
    "@babel/types": "7.29.7",

    "chalk": "5.6.2",
    "cross-env": "10.1.0",
    "execa": "9.6.1",
    "github-slugger": "2.0.0",
    "jest-serializer-path": "0.1.15",
    "typescript": "6.0.3",
    "verdaccio-memory": "10.4.5",
    "webpack": "5.107.2"
  },
  "resolutions": {
    "trim": "0.0.3",
    "d3-color": "3.1.0",
    "lodash": "4.18.1",
    "semver": "7.8.1",
    "minimatch": "10.2.5",
    "json5": "2.2.3",
    "tough-cookie": "6.0.1",
    "@sinonjs/fake-timers": "15.4.0",
    "@types/node": "25.9.1",
    "@babel/traverse": "7.29.7",
    "form-data": "4.0.5",
    "handlebars": "4.7.9",
    "shell-quote": "1.8.4",
    "simple-git": "3.36.0",
    "loader-utils": "3.3.1",
    "ejs": "6.0.1",
    "dompurify": "3.4.7",
    "immer": "11.1.8",
    "cipher-base": "1.0.7",
    "elliptic": "6.6.1",
    "pbkdf2": "3.1.6",
    "sha.js": "2.4.12",
    "parse-url": "11.1.0",
    "tar": "7.5.16",
    "node-forge": "1.4.0",
    "cross-spawn": "7.0.6",
    "braces": "3.0.3",
    "axios": "1.16.1",
    "decode-uri-component": "0.4.1",
    "picomatch": "4.0.4",
    "ansi-regex": "6.2.2",
    "tar-fs": "3.1.2",
    "tmp": "0.2.7",
    "trim-newlines": "5.0.0",
    "http-cache-semantics": "4.2.0",
    "body-parser": "2.2.2",
    "ip": "2.0.1",
    "qs": "6.15.2",
    "serialize-javascript": "7.0.5",
    "prismjs": "1.30.0",
    "nth-check": "3.0.1"
  },
  "overrides": {
    "trim": "0.0.3",
    "d3-color": "3.1.0"
  }
}
