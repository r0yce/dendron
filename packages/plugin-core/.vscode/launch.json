// Launch configurations for developing the Dendron VS Code extension.
//
// IMPORTANT: These configs assume you have the `packages/plugin-core` folder
// (or dendron-plugin.code-workspace) open as your VS Code workspace root.
//
// === RECOMMENDED DEBUG WORKFLOW (Clean Host + normal dev) ===
// The extension is primarily built with Webpack, not plain tsc.
//
// 1. Run the background task once:
//    Terminal → Run Task → "watch-webpack"  (this runs `webpack:dev:watch`)
//
// 2. Use one of these launch configs (they have no preLaunchTask):
//    - "Run Dendron Extension (Desktop, No Precompile)"
//    - "Run Dendron Extension (Clean Host, No Precompile)"   ← best for Clean Host testing
//
// This gives you fast iteration with source maps and avoids the fragile plain `tsc` compile.
//
// The old "compile-plugin-core" task (plain tsc) is currently unreliable for debugging
// due to strict mode settings and is not the production build path.
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Dendron Extension (Desktop)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "preLaunchTask": "compile-plugin-core",
      "env": {
        "LOG_LEVEL": "debug",
        "DENDRON_DEV_MODE": "1",
        "DENDRON_PERF": "1"
      },
      "presentation": {
        "group": "dendron",
        "order": 1
      },
      "detail": "Legacy - uses fragile tsc compile. Prefer 'Run Dendron Extension (Desktop, No Precompile)' + watch-webpack task."
    },
    {
      "name": "Run Dendron Extension (Desktop, No Precompile)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "env": {
        "LOG_LEVEL": "debug",
        "DENDRON_DEV_MODE": "1"
      },
      "presentation": {
        "group": "dendron",
        "order": 2
      },
      "detail": "RECOMMENDED for normal development. Start 'watch-webpack' task first."
    },
    {
      "name": "Run Dendron Extension (Clean Host - disable all other extensions)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/plugin-core",
        "--disable-extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "env": {
        "LOG_LEVEL": "debug",
        "DENDRON_DEV_MODE": "1",
        "DENDRON_PERF": "1"
      },
      "presentation": {
        "group": "dendron",
        "order": 3
      },
      "detail": "DEPRECATED for daily use - depends on fragile tsc compile. Prefer the No Precompile version below + watch-webpack task."
    },
    {
      "name": "Run Dendron Extension (Clean Host, No Precompile)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/plugin-core",
        "--disable-extensions"
      ],
      "outFiles": [
        "${workspaceFolder}/out/**/*.js"
      ],
      "env": {
        "LOG_LEVEL": "debug",
        "DENDRON_DEV_MODE": "1"
      },
      "presentation": {
        "group": "dendron",
        "order": 4
      },
      "detail": "RECOMMENDED for Clean Host. Start 'watch-webpack' task first, then use this launch config."
    },
    // {
    //   "name": "Run Web Extension in VS Code",
    //   "type": "pwa-extensionHost",
