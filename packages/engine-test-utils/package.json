  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/dendronhq/dendron.git",
    "directory": "packages/engine-test-utils"
  },
  "author": {
    "name": "Kevin Lin",
    "email": "kevin@thence.io",
    "url": "https://kevinslin.com"
  },
  "keywords": [],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('lib',{recursive:true,force:true}); fs.rmSync('coverage',{recursive:true,force:true});\"",
    "format": "echo nop",
    "lint": "echo stub",
    "prepublishOnly": "yarn build",
    "prebuild": "yarn clean && yarn format && yarn lint && echo Using TypeScript && tsc --version",
    "build": "yarn compile",
    "buildCI": "yarn clean && yarn compile",
    "compile": "tsc -p tsconfig.build.json",
    "coverage": "jest --coverage",
    "watch": "tsup --watch",
    "build:js": "tsup",
    "build:types": "node --max-old-space-size=8192 ./scripts/build-types.js",
    "build:modern": "yarn build:js && yarn build:types",
    "compile:tsc": "tsc -p tsconfig.build.json",
    "build:timed": "time yarn build:modern 2>&1 | tee -a /tmp/dendron-build-modernization-next-batch.log"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@testing-library/react-hooks": "8.0.1",
    "@types/fs-extra": "11.0.4",
    "@types/lodash": "4.17.24",
    "@types/node": "26.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dendronhq/api-server": "^0.124.0",
    "@dendronhq/common-all": "^0.124.0",
    "@dendronhq/common-frontend": "^0.124.0",
    "@dendronhq/common-server": "^0.124.0",
    "@dendronhq/common-test-utils": "^0.124.0",
    "@dendronhq/dendron-cli": "^0.124.0",
    "@dendronhq/engine-server": "^0.124.0",
    "@dendronhq/pods-core": "^0.124.0",
    "@dendronhq/unified": "^0.124.0",
    "@reduxjs/toolkit": "2.12.0",
    "@types/sinon": "21.0.1",
    "cross-env": "10.1.0",
    "fs-extra": "11.3.5",
    "jest": "30.4.2",
    "jest-mock-extended": "4.0.1",
    "lodash": "4.18.1",
    "prompts": "2.4.2",
    "react": "19.2.8",
    "react-redux": "9.3.0",
    "react-test-renderer": "19.2.7",
    "sinon": "22.0.0"
  }
