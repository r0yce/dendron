  "description": "dendron-engine",
  "license": "Apache 2.0",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/dendronhq/dendron.git",
    "directory": "packages/engine-server"
  },
  "author": {
    "name": "Kevin Lin",
    "email": "kevin@thence.io",
    "url": "https://kevinslin.com",
    "organization": true
  },
  "keywords": [
    ""
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('lib',{recursive:true,force:true}); fs.rmSync('coverage',{recursive:true,force:true}); fs.rmSync('src/drivers/generated-prisma-client',{recursive:true,force:true});\"",
    "format": "echo 'format not configured'",
    "lint": "echo 'lint not configured'",
    "buildPrismaClient": "yarn prisma generate && node copyPrismaClient.js",
    "prepublishOnly": "yarn build",
    "prebuild": "yarn clean && yarn format && yarn lint && echo Using TypeScript && tsc --version",
    "build": "yarn compile && yarn buildPrismaClient",
    "buildCI": "yarn compile && yarn buildPrismaClient",
    "compile": "tsc -p tsconfig.build.json && yarn buildPrismaClient",
    "watch": "tsup --watch",
    "build:js": "tsup",
    "build:types": "node --max-old-space-size=8192 ./scripts/build-types.js",
    "build:modern": "yarn build:js && yarn build:types",
    "build:timed": "echo \"=== TIMING engine-server ===\" && time yarn build:modern 2>&1 | tee -a /tmp/dendron-build-modernization-trio-timing.log ; echo \"=== END === (see log)\"",
    "compile:tsc": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@dendronhq/common-all": "^0.124.0",
