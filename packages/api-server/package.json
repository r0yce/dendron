{
  "name": "@dendronhq/api-server",
  "version": "0.124.0",
  "description": "",
  "license": "Apache 2.0",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/dendronhq/dendron.git",
    "directory": "packages/api-server"
  },
  "author": {
    "name": "Kevin Lin",
    "email": "kevin@thence.io",
    "url": "https://kevinslin.com"
  },
  "keywords": [],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('lib',{recursive:true,force:true}); fs.rmSync('coverage',{recursive:true,force:true});\"",
    "format": "echo 'format not configured'",
    "lint": "echo 'lint not configured'",
    "prepublishOnly": "yarn build",
    "prebuild": "yarn clean && yarn format && yarn lint && echo Using TypeScript && tsc --version",
    "build": "yarn compile",
    "buildCI": "yarn compile",
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsup --watch",
    "start:local:old": "cross-env PORT=3005 LOG_LEVEL=info npx ts-node ./src/start.ts",
    "start:local": "cross-env PORT=3005 LOG_LEVEL=info nodemon --watch 'src/**/*.ts' lib/start.js",
    "local:dev:custom": "env AWS_PROFILE=dendron-dev LOCAL=true PORT=3005 LOG_LEVEL=info nodemon --watch 'server/**/*.ts' dist/server/index.js | pino-pretty | tee /tmp/out.txt",
    "start:integ:debug": "cross-env PORT=3005 TS_NODE_LOG_ERROR=1 node --inspect -r ts-node/register ./src/start.ts",
    "start:integ:watch": "cross-env PORT=3005 LOG_DST=../../logs/api-server.log LOG_LEVEL=debug npx nodemon --watch 'src/**/*.ts' --ignore 'src/**/*.spec.ts'",
    "build:js": "tsup",
    "build:types": "node --max-old-space-size=8192 ./scripts/build-types.js",
    "build:modern": "yarn build:js && yarn build:types",
    "compile:tsc": "tsc -p tsconfig.build.json",
    "build:timed": "time yarn build:modern 2>&1 | tee -a /tmp/dendron-build-modernization-v2.log"
  },
  "devDependencies": {
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/lodash": "4.17.24",
    "@types/morgan": "1.9.10",
    "@types/node": "26.1.1",
    "nodemon": "3.1.14",
    "ts-node": "10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dendronhq/common-all": "^0.124.0",
    "@dendronhq/common-server": "^0.124.0",
    "@dendronhq/engine-server": "^0.124.0",
    "@dendronhq/unified": "^0.124.0",
    "@sentry/integrations": "7.114.0",
    "@sentry/node": "10.67.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "express-async-handler": "1.2.0",
    "fs-extra": "11.3.5",
    "klaw": "4.1.0",
    "lodash": "4.18.1",
    "morgan": "1.10.1",
    "querystring": "0.2.1"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts, html",
    "ignore": [
      "src/public"
    ],
    "exec": "ts-node --log-error ./src/start.ts"
  },
  "gitHead": "b9b209acf808ad7a581bf98b1d0f90ef2bf4b833"
}
