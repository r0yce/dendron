{
  "name": "@dendronhq/common-server",
  "version": "0.124.0",
  "description": "common-server",
  "license": "Apache 2.0",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/dendronhq/dendron.git",
    "directory": "packages/common-server"
  },
  "author": {
    "name": "Kevin Lin",
    "email": "kevin@thence.io",
    "url": "https://kevinslin.com",
    "organization": true
  },
  "keywords": [
    ""
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('lib',{recursive:true,force:true}); fs.rmSync('coverage',{recursive:true,force:true});\"",
    "format": "echo 'format not configured'",
    "lint": "echo 'lint not configured'",
    "prepublishOnly": "yarn build",
    "prebuild": "yarn clean && yarn format && yarn lint && echo Using TypeScript && tsc --version",
    "build": "yarn compile",
    "buildCI": "yarn compile",
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsup --watch",
    "build:js": "tsup",
    "build:types": "node --max-old-space-size=8192 ./scripts/build-types.js",
    "build:modern": "yarn build:js && yarn build:types",
    "build:timed": "echo \"=== TIMING common-server ===\" && time yarn build:modern 2>&1 | tee -a /tmp/dendron-build-modernization-trio-timing.log ; echo \"=== END === (see log)\"",
    "compile:tsc": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@dendronhq/common-all": "^0.124.0",
    "@sentry/integrations": "7.114.0",
    "@sentry/node": "10.67.0",
    "ajv": "8.20.0",
    "ajv-errors": "3.0.0",
    "analytics-node": "6.2.0",
    "anymatch": "3.1.3",
    "comment-json": "5.0.0",
    "execa": "9.6.1",
    "fs-extra": "11.3.5",
    "gray-matter": "4.0.3",
    "handlebars": "4.7.9",
    "js-yaml": "4.2.0",
    "lodash": "4.18.1",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "simple-git": "3.36.0",
    "spark-md5": "3.0.2",
    "textextensions": "6.11.0",
    "tmp": "0.2.7",
    "vscode-uri": "3.1.0",
    "yaml-unist-parser": "3.2.0"
  },
  "devDependencies": {
    "@types/analytics-node": "3.1.14",
    "@types/comment-json": "2.4.5",
    "@types/express": "5.0.6",
    "@types/fs-extra": "11.0.4",
    "@types/js-yaml": "4.0.9",
    "@types/lodash": "4.17.24",
    "@types/node": "26.1.1",
    "@types/pino": "7.0.5",
    "@types/spark-md5": "3.0.5",
    "@types/tmp": "0.2.6",
    "ts-node": "10.9.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
