{
  "name": "@dendronhq/common-di",
  "version": "0.124.0",
  "description": "Dendron DI container wrappers, typed tokens (DiToken), and declarative registration facade for tsyringe. Pure (no vscode). See ADR 0001.",
  "license": "Apache 2.0",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/dendronhq/dendron.git",
    "directory": "packages/common-di"
  },
  "author": {
    "name": "Dendron INC",
    "email": "eng@dendron.so",
    "url": "https://www.dendron.so"
  },
  "keywords": [
    "common",
    "di",
    "tsyringe",
    "dependency-injection",
    "tokens"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); ['lib','coverage'].forEach(d => { try { fs.rmSync(d,{recursive:true,force:true}); } catch(e){} });\"",
    "prepublishOnly": "yarn build",
    "prebuild": "yarn clean",
    "build": "yarn compile",
    "buildCI": "yarn compile",
    "compile": "tsc -p tsconfig.build.json",
    "watch": "yarn compile --watch"
  },
  "dependencies": {
    "reflect-metadata": "^0.1.13",
    "tsyringe": "^4.7.0"
  },
  "peerDependencies": {
    "reflect-metadata": "^0.1.13",
    "tsyringe": "^4.7.0"
  },
  "devDependencies": {},
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
