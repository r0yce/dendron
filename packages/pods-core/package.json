{
  "name": "@dendronhq/pods-core",
  "version": "0.124.0",
  "description": "pods-core",
  "license": "Apache 2.0",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/dendronhq/dendron.git",
    "directory": "packages/pods-core"
  },
  "author": {
    "name": "Kevin Lin",
    "email": "kevin@thence.io",
    "url": "https://kevinslin.com"
  },
  "keywords": [
    "common"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('lib',{recursive:true,force:true}); fs.rmSync('coverage',{recursive:true,force:true});\"",
    "format": "echo 'format not configured'",
    "lint": "echo 'lint not configured'",
    "prepublishOnly": "yarn build",
    "prebuild": "yarn clean && yarn format && yarn lint && echo Using TypeScript && tsc --version",
    "build": "yarn compile",
    "buildCI": "yarn compile",
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsup --watch",
    "test:unit:debug": "NODE_ENV=test node --inspect-brk node_modules/.bin/jest --runInBand",
    "build:js": "tsup",
    "build:types": "node --max-old-space-size=8192 ./scripts/build-types.js",
    "build:modern": "yarn build:js && yarn build:types",
    "compile:tsc": "tsc -p tsconfig.build.json",
    "build:timed": "time yarn build:modern 2>&1 | tee -a /tmp/dendron-build-modernization-next-batch.log"
  },
  "devDependencies": {
    "@types/async": "3.2.25",
    "@types/form-data": "2.5.2",
    "@types/fs-extra": "11.0.4",
    "@types/klaw": "3.0.7",
    "@types/lodash": "4.17.24",
    "@types/node": "26.1.1",
    "@types/through2": "2.0.41",
    "ts-node": "10.9.2"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dendronhq/common-all": "^0.124.0",
    "@dendronhq/common-server": "^0.124.0",
    "@dendronhq/engine-server": "^0.124.0",
    "@dendronhq/unified": "^0.124.0",
    "@instantish/martian": "1.1.1",
    "@notionhq/client": "5.23.2",
    "@octokit/graphql": "9.0.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "async": "3.2.6",
    "csv-writer": "1.6.0",
    "emailjs": "5.0.2",
    "form-data": "4.0.6",
    "fs-extra": "11.3.5",
    "googleapis": "173.0.0",
    "image-downloader": "4.3.0",
    "klaw": "4.1.0",
    "limiter": "3.0.0",
    "lodash": "4.18.1",
    "through2": "5.0.1",
    "vscode-uri": "3.1.0"
  },
  "gitHead": "b9b209acf808ad7a581bf98b1d0f90ef2bf4b833"
}
