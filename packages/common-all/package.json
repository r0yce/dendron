{
  "name": "@dendronhq/common-all",
  "version": "0.124.0",
  "description": "common-all",
  "license": "Apache 2.0",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/dendronhq/dendron.git",
    "directory": "packages/common-all"
  },
  "author": {
    "name": "Kevin Lin",
    "email": "kevin@thence.io",
    "url": "https://kevinslin.com"
  },
  "keywords": [
    "common"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); ['lib','coverage'].forEach(d => { try { fs.rmSync(d,{recursive:true,force:true}); } catch(e){} });\"",
    "format": "echo 'format not configured'",
    "lint": "echo 'lint not configured'",
    "prepublishOnly": "yarn build",
    "prebuild": "yarn clean && yarn format && yarn lint && echo Using TypeScript && tsc --version",
    "build": "yarn compile",
    "buildCI": "yarn compile",
    "compile": "tsc -p tsconfig.build.json",
    "compile:tsc": "tsc -p tsconfig.build.json",
    "build:js": "tsup",
    "build:types": "node --max-old-space-size=8192 ./scripts/build-types.js",
    "watch": "tsup --watch",
    "build:modern": "yarn build:js && yarn build:types",
    "build:timed": "time yarn build:modern 2>&1 | tee -a /tmp/dendron-build-modernization-next-batch.log"
  },
  "dependencies": {
    "@swc/helpers": "0.5.23",
    "axios": "1.16.1",
    "dropbox": "10.34.0",
    "fast-levenshtein": "3.0.0",
    "fuse.js": "7.4.1",
    "github-slugger": "2.0.0",
    "gray-matter": "4.0.3",
    "http-status-codes": "2.3.0",
    "js-yaml": "4.2.0",
    "lodash": "4.18.1",
    "luxon": "3.7.2",
    "minimatch": "10.2.5",
    "nanoid": "5.1.11",
    "neverthrow": "8.2.0",
    "normalize-path": "3.0.0",
    "qs": "6.15.2",
    "semver": "7.8.1",
    "spark-md5": "3.0.2",
    "title": "4.0.1",
    "vscode-uri": "3.1.0",
    "zod": "4.4.3",
    "zod-validation-error": "5.0.0"
  },
  "devDependencies": {
    "@types/fast-levenshtein": "0.0.4",
    "@types/github-slugger": "2.0.0",
    "@types/js-yaml": "4.0.9",
    "@types/lodash": "4.17.24",
    "@types/luxon": "3.7.1",
    "@types/minimatch": "6.0.0",
    "@types/nanoid-dictionary": "4.2.3",
    "@types/node": "25.9.1",
    "@types/normalize-path": "3.0.2",
    "@types/semver": "7.7.1",
    "@types/title": "4.0.0",
    "@types/unist": "3.0.3",
    "coveralls": "3.1.1",
    "tslint": "6.1.3",
    "tslint-config-prettier": "1.18.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
