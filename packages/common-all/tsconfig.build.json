{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    // Temporary during strict cleanup wave. Root has flags enabled. Real remaining ~48 errors tracked in MONOREPO tracker.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
