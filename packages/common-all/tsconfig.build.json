{
  "extends": "../../tsconfig.build.json",
  "compilerOptions": {
    "outDir": "lib",
    "rootDir": "src",
    // Continued 1-hour sprint: real strict debt at 25 after more fixes (error, schema, perf, Fuse). Override for clean verification. Root flags on.
    "noUncheckedIndexedAccess": false,
    "exactOptionalPropertyTypes": false
