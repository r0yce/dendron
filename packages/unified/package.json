{
  "name": "@dendronhq/unified",
  "version": "0.124.0",
  "description": "Unified parser utilities for Dendron",
  "license": "Apache 2.0",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/dendronhq/dendron.git",
    "directory": "packages/unified"
  },
  "author": {
    "name": "Dendron INC",
    "email": "eng@dendron.so",
    "url": "https://www.dendron.so"
  },
  "keywords": [
    "common"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('lib',{recursive:true,force:true}); fs.rmSync('coverage',{recursive:true,force:true});\"",
    "prepublishOnly": "yarn build",
    "prebuild": "yarn clean",
    "build": "yarn compile",
    "buildCI": "yarn compile",
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsup --watch",
    "build:js": "tsup",
    "build:types": "node --max-old-space-size=8192 ./scripts/build-types.js",
    "build:modern": "yarn build:js && yarn build:types",
    "build:timed": "echo \"=== TIMING unified ===\" && time yarn build:modern 2>&1 | tee -a /tmp/dendron-build-modernization-trio-timing.log ; echo \"=== END === (see log)\"",
    "compile:tsc": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@dendronhq/common-all": "^0.124.0",
    "hast-util-parse-selector": "4.0.0",
    "hast-util-select": "6.0.4",
    "mdast": "3.0.0",
    "mdast-builder": "1.1.1",
    "mdast-util-compact": "5.0.0",
    "mdast-util-inject": "1.1.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-slug": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark": "15.0.1",
    "remark-abbr": "1.4.2",
    "remark-containers": "1.2.0",
    "remark-gfm": "4.0.1",
    "remark-frontmatter": "5.0.0",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "remark-stringify": "11.0.0",
    "remark-toc": "9.0.0",
    "remark-variables": "1.4.9",
    "remark-wiki-link": "2.0.1",
    "unified": "11.0.5",
    "unified-engine": "11.2.2",
    "unist-builder": "4.0.0",
    "unist-util-select": "5.1.0",
    "unist-util-visit": "5.1.0",
    "vscode-uri": "3.1.0",
    "yaml-unist-parser": "3.2.0"
  },
  "devDependencies": {
    "@types/mdast": "4.0.4",
    "@types/unist": "3.0.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
