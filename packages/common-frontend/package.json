{
  "name": "@dendronhq/common-frontend",
  "version": "0.124.0",
  "description": "common-frontend",
  "license": "Apache 2.0",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com/dendronhq/dendron.git",
    "directory": "packages/common-frontend"
  },
  "author": {
    "name": "Kevin Lin",
    "email": "kevin@thence.io",
    "url": "https://kevinslin.com"
  },
  "keywords": [
    "common"
  ],
  "files": [
    "lib"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('lib',{recursive:true,force:true}); fs.rmSync('coverage',{recursive:true,force:true});\"",
    "format": "echo nop",
    "lint": "echo stub",
    "prepublishOnly": "yarn build",
    "prebuild": "yarn clean && yarn format && yarn lint && echo Using TypeScript && tsc --version",
    "build": "yarn compile",
    "buildCI": "yarn compile",
    "compile": "tsc -p tsconfig.build.json",
    "watch": "tsup --watch",
    "build:js": "tsup",
    "build:types": "node --max-old-space-size=8192 ./scripts/build-types.js",
    "build:modern": "yarn build:js && yarn build:types",
    "compile:tsc": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@aws-amplify/core": "6.16.3",
    "@dendronhq/common-all": "^0.124.0",
    "@reduxjs/toolkit": "2.12.0",
    "lodash": "4.18.1",
    "querystring": "0.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-redux": "9.3.0",
    "redux-logger": "3.0.6"
  },
  "devDependencies": {
    "@types/lodash": "4.17.24",
    "@types/node": "25.9.1",
    "@types/react": "19.2.16",
    "@types/redux-logger": "3.0.13"
  },
  "nohoist": [
    "**/common-all",
    "**/common-all/**"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
