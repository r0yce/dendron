{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Dendron Extension (Desktop) - [open monorepo root]",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/plugin-core"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/plugin-core/out/**/*.js"
      ],
      "preLaunchTask": "compile:plugin-core",
      "env": {
        "LOG_LEVEL": "debug",
        "DENDRON_DEV_MODE": "1",
        "DENDRON_PERF": "1"
      },
      "presentation": {
        "group": "dendron-root"
      },
      "detail": "Legacy (uses fragile tsc). Prefer the No Precompile version + start 'watch-webpack' task in packages/plugin-core"
    },
    {
      "name": "Run Dendron Extension (Desktop, No Precompile) - [open monorepo root]",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/plugin-core"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/plugin-core/out/**/*.js"
      ],
      "env": {
        "LOG_LEVEL": "debug",
        "DENDRON_DEV_MODE": "1",
        "DENDRON_PERF": "1"
      },
      "presentation": {
        "group": "dendron-root"
      },
      "detail": "RECOMMENDED when opening the full monorepo. Start watch-webpack in packages/plugin-core first."
    },
    {
      "name": "Debug Dendron Extension Tests (Integration)",
      "type": "extensionHost",
      "request": "launch",
      "runtimeExecutable": "${execPath}",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/plugin-core",
        "--extensionTestsPath=${workspaceFolder}/packages/plugin-core/out/src/test/suite-integ/index"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/plugin-core/out/**/*.js"
      ],
      "preLaunchTask": "compile:plugin-core",
      "detail": "Note: Tests may require the tsc compile step. For extension runtime debugging, prefer webpack watch + No Precompile configs."
    },
    {
      "name": "Debug Current Test File (Jest, engine-test-utils)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/jest/bin/jest.js",
      "sourceMaps": true,
      "smartStep": true,
      "env": {
        "LOG_LEVEL": "info",
        "LOG_DST": "${workspaceFolder}/engine-test-utils-debug.log"
      },
      "args": [
        "--findRelatedTests",
        "--runInBand",
        "${relativeFile}",
        "-u"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/engine-test-utils/lib/**/*.js"
      ]
    },
    {
      "name": "Attach to Running Extension Host",
      "type": "extensionHost",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "outFiles": [
        "${workspaceFolder}/packages/plugin-core/out/**/*.js"
      ]
    },
    {
      "name": "Debug Dendron-CLI (ts-node bin + doctor health)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["-r", "ts-node/register"],
      "args": ["${workspaceFolder}/packages/dendron-cli/bin/dendron-cli.ts", "health", "--verbose", "--json"],
      "cwd": "${workspaceFolder}",
      "env": {
        "LOG_LEVEL": "debug",
        "DENDRON_PERF": "1",
        "TS_NODE_PROJECT": "${workspaceFolder}/packages/dendron-cli/tsconfig.build.json"
      },
      "outFiles": ["${workspaceFolder}/packages/dendron-cli/lib/**/*.js"],
      "presentation": { "group": "dendron-cli" }
    },
    {
      "name": "Debug Doctor (health checks + perf)",
      "type": "node",
      "request": "launch",
      "runtimeArgs": ["-r", "ts-node/register"],
      "args": ["${workspaceFolder}/packages/dendron-cli/bin/dendron-cli.ts", "health", "--checks", "sqlite,engine,git,yml,deps", "--verbose"],
      "cwd": "${workspaceFolder}",
      "env": { "DENDRON_PERF": "1", "LOG_LEVEL": "debug" },
      "outFiles": ["${workspaceFolder}/packages/dendron-cli/lib/**/*.js"],
      "presentation": { "group": "dendron-cli" }
    },
    {
      "name": "Attach to Engine Server (for perf/doctor debug)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "outFiles": ["${workspaceFolder}/packages/engine-server/lib/**/*.js"]
    }
  ],
  "compounds": [
    {
      "name": "Dendron: Full Debug (Extension + Engine Tests)",
      "configurations": ["Run Dendron Extension (Desktop)", "Debug Current Test File (Jest, engine-test-utils)"]
    },
    {
      "name": "Dendron p6 DX: Plugin-Core + Doctor CLI (health + perf breakpoints)",
      "configurations": ["Run Dendron Extension (Desktop) - [open monorepo root]", "Debug Dendron-CLI (ts-node bin + doctor health)", "Debug Doctor (health checks + perf)"]
    },
    {
      "name": "Dendron p6+7 DX: Full Insiders Perf (Extension + RingBuffer Doctor)",
      "configurations": ["Run Dendron Extension (Desktop) - [open monorepo root]", "Debug Doctor (health checks + perf)"]
    }
  ]
}