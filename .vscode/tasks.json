{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "type": "npm",
      "script": "gen:data",
      "problemMatcher": [],
      "label": "generate JSON schema",
      "detail": "node packages/dendron-cli/lib/bin/dendron-cli.js dev generate_json_schema_from_config"
    },
    {
      "label": "test:watch",
      "command": "yarn test ${relativeFile} --watch --bail -u",
      "type": "shell",
      "problemMatcher": [],
      "options": {
        "env": {
          "LOG_LEVEL": "info",
          "LOG_DST": "${workspaceFolder}/engine-test-utils.log"
        }
      }
    },
    {
      "label": "compile:plugin-core",
      "type": "shell",
      "command": "yarn workspace @dendronhq/plugin-core compile",
      "problemMatcher": ["$tsc"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      },
      "detail": "Strict tsc compile (green under tsconfig.build.json). For day-to-day extension debugging, prefer watch-webpack in packages/plugin-core."
    },
    {
      "label": "verify:modernization",
      "type": "shell",
      "command": "yarn verify:modernization",
      "problemMatcher": [],
      "group": "build",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "compile:watch:plugin-core",
      "type": "shell",
      "command": "yarn workspace @dendronhq/plugin-core watch",
      "isBackground": true,
      "problemMatcher": ["$tsc-watch"],
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      }
    },
    {
      "label": "bootstrap:fast (common packages + plugin)",
      "type": "shell",
      "command": "yarn bootstrap:build:fast",
      "problemMatcher": [],
      "group": "build",
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "doctor:smoke (health --verbose + json)",
      "type": "shell",
      "command": "yarn workspace @dendronhq/dendron-cli build && node packages/dendron-cli/lib/bin/dendron-cli.js health --verbose --json",
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always" }
    },
    {
      "label": "tsc:plugin-core --noEmit (strict/DI wave)",
      "type": "shell",
      "command": "yarn workspace @dendronhq/plugin-core tsc --noEmit -p tsconfig.build.json",
      "problemMatcher": ["$tsc"],
      "group": "build"
    },
    {
      "label": "Lerna: list packages (post A/B)",
      "type": "shell",
      "command": "npx lerna list --all",
      "problemMatcher": []
    },
    {
      "label": "p6 DX: doctor health smoke + --fix dry (zero-ramp debug)",
      "type": "shell",
      "command": "yarn workspace @dendronhq/dendron-cli build && node packages/dendron-cli/lib/bin/dendron-cli.js health --checks sqlite,git,yml --verbose --json",
      "problemMatcher": [],
      "group": "test",
      "presentation": { "reveal": "always", "focus": true }
    },
    {
      "label": "p7 Perf: doctor + ringbuffer dump (insiders tie-in)",
      "type": "shell",
      "command": "DENDRON_PERF=1 yarn workspace @dendronhq/dendron-cli build && node packages/dendron-cli/lib/bin/dendron-cli.js health --verbose --json 2>&1 | cat",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "label": "p6+8: tsc --noEmit common-all + plugin-core (perf foundation waves)",
      "type": "shell",
      "command": "yarn workspace @dendronhq/common-all tsc --noEmit -p tsconfig.build.json && yarn workspace @dendronhq/plugin-core tsc --noEmit -p tsconfig.build.json",
      "problemMatcher": ["$tsc"],
      "group": "build"
    },
    {
      "label": "p9 Longterm: build modernize spike note (esbuild/vite proxy)",
      "type": "shell",
      "command": "echo 'p9 spike: tsup/esbuild candidate for dendron-cli post Lerna8 (see docs/dev/TELEMETRY.md + 00-GOALS). Run: npx tsup --entry src/bin/dendron-cli.ts --format cjs --dts' && echo 'Verify: time node lib/bin/dendron-cli.js health --help'",
      "problemMatcher": []
    }
  ]
}